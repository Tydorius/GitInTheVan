# GitInTheVan cross-platform test harness configuration.
#
# Copy to harness.env and fill in for your environment. harness.env is
# gitignored -- it holds host addresses and a throwaway admin password.
#
#   cp testing/harness.env.example testing/harness.env
#
# Every value can be overridden on the command line; see testing/README.md.

# ---------------------------------------------------------------- source ---

REPO_URL=https://github.com/Tydorius/GitInTheVan
BRANCH=main

# Port the test instance listens on. Kept off 8000 by default so a run cannot
# collide with a real GitInTheVan already running on the target.
GITV_PORT=8100

# --------------------------------------------------------------- targets ---
#
# Each target needs an SSH destination and a parent folder. The harness never
# writes directly into the folder: it creates
#   <FOLDER>/_gitv-testruns/<run-id>/GitInTheVan
# and teardown will only ever delete a directory carrying its own run marker.
#
# Leave a TARGET_* blank to disable that target.

# macOS -- native install via scripts/deploy-macos.sh
TARGET_MACOS=tydorius@10.0.0.139
MACOS_FOLDER=~/github

# Linux -- native install via scripts/deploy-linux.sh.
# Point this at the dedicated clean test container, not the hypervisor.
TARGET_LINUX=root@10.0.2.50
LINUX_FOLDER=~/github

# Docker -- image build + docker compose, run directly on a dock-xx host.
# No nesting: this is the Docker host itself, not a container on it.
TARGET_DOCKER=root@dock-52
DOCKER_FOLDER=~/github
DOCKER_COMPOSE_FILE=docker-compose.sqlite.yml

# Windows -- native install via scripts\deploy-windows.bat.
# The literal value 'localhost' means "this machine", and SSH is skipped
# entirely; commands run locally.
TARGET_WINDOWS=localhost
WINDOWS_FOLDER=E:\github\_gitv-testing

# ------------------------------------------------------------------- ssh ---

# Optional jump host for targets not directly reachable from this machine.
# Applied as ssh -J. Leave blank if every target is directly routable.
SSH_JUMP=

# Extra flags appended to every ssh/scp invocation. BatchMode keeps a missing
# key from hanging on a password prompt instead of failing fast.
SSH_OPTS=-o BatchMode=yes -o ConnectTimeout=15

# ----------------------------------------------------------------- admin ---
#
# The harness creates this admin account on the fresh instance via
# POST /api/auth/setup. The password MUST satisfy the app's own strength
# rules (app/services/auth.py): at least 8 characters, and at least one
# letter AND one digit. 'testpassword' is rejected; 'testpassword1' is fine.

ADMIN_USER=admin
ADMIN_PASSWORD=testpassword1

# --------------------------------------------------------------- results ---

# Where pulled logs are archived, relative to the repo root. Retained until
# you delete them -- teardown never touches this directory.
ARCHIVE_DIR=./testing/artifacts
